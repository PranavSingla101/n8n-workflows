        "messages": {
          "values": [
            {
              "content": "=You're a helpful, intelligent website research assistant.\n\nYou're given a Markdown scrape of one page from a company website. Write a two-paragraph abstract of what this page is about.\n\nReturn in this JSON format:\n\n{\"abstract\":\"your abstract goes here\"}\n\nRules:\n- Be comprehensive, with the level of detail of an abstract to a published paper.\n- Use a straightforward, spartan tone of voice.\n- If the page is empty, return \"no content\".\n\nPage URL: {{ $json.metadata?.sourceURL || $json.metadata?.url || '' }}\n\nPage content:\n{{ ($json.markdown || '').slice(0, 20000) }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.1,
      "position": [
        1392,
        2160
      ],
      "id": "e912d7c2-d074-43e6-a72c-0bff6d17767d",
