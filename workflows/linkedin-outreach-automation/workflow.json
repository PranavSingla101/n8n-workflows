    {
      "parameters": {
        "jsCode": "// Flatten each HubSpot contact into the fields the prompt needs\nconst contacts = $('Fetch Leads').all();\n\nreturn contacts.map(contact => {\n  const props = contact.json.properties;\n  return {\n    json: {\n      argument: {\n        LinkedinUrl: props.hs_linkedin_url,\n        name: props.firstname,\n        company: props.company,\n        jobtitle: props.jobtitle,\n        industry: props.industry,\n        company_information: props.company_information\n      }\n    }\n  }\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -368,
        -560
      ],
      "id": "3da49b19-d84c-4a87-b524-2b09540f3d5b",
      "name": "Normalize Data"
    },
    {
      "parameters": {
        "options": {}
      },
