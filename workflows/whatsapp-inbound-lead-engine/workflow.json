{
  "name": "WhatsApp Inbound Lead Engine",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const required = ['name', 'phone', 'inquiry', 'source', 'timestamp'];\nconst body = $input.first().json.body ?? $input.first().json;\n\nfor (const field of required) {\n  if (!body[field]) throw new Error(`Missing required field: ${field}`);\n}\n\nreturn [{\n  json: {\n    lead_id: $execution.id + '-' + Date.now(),\n    name: String(body.name).trim(),\n    phone: String(body.phone).replace(/\\s+/g, ''),\n    inquiry: String(body.inquiry).trim(),\n    source: body.source,\n    timestamp: body.timestamp,\n    metadata: body.metadata ?? {},\n    created_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "70696383-a2ee-4c3a-ad91-d68280cf23b4",
      "name": "Validate & Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1088,
        400
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"accepted\", \"message\": \"Lead received and queued for processing\" }",
        "options": {
          "responseCode": 200
        }
      },
      "id": "387902ee-adf9-491f-bb95-031b3c2cacbb",
      "name": "Acknowledge 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        -864,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Validate & Normalize').first().json;\n\nconst prompt = `You are a premium sales assistant. A new lead submitted an inquiry.\n\nLead Details:\n- Name: ${lead.name}\n- Inquiry: ${lead.inquiry}\n- Source: ${lead.source}\n\nTasks:\n1. Classify the intent (e.g. pricing, demo, support, general inquiry)\n2. Write a concise 1-sentence summary of the lead\n3. Write a personalized WhatsApp outreach message (STRICT MAX 700 chars). Be helpful, professional, and match the language the lead used.\n\nIMPORTANT: Respond ONLY with valid JSON. No markdown, no explanation. Format:\n{\n  \"intent_classification\": \"...\",\n  \"short_summary\": \"...\",\n  \"personalized_whatsapp_message\": \"...\"\n}`;\n\nreturn [{ json: { ...lead, prompt } }];"
      },
      "id": "0938f93a-fb96-4392-bdc4-a772fe0aca2b",
      "name": "Prepare LLM Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        192,
        416
      ]
    },
    {
      "parameters": {
        "jsCode": "const claudeResp = $input.first().json;\nconst lead = $('Prepare LLM Prompt').first().json;\n\nlet parsed;\ntry {\n  const rawText = claudeResp.content[0].text;\n  parsed = JSON.parse(rawText);\n} catch (e) {\n  // LLM fallback — safe template\n  parsed = {\n    intent_classification: 'unknown',\n    short_summary: 'New inbound lead inquiry',\n    personalized_whatsapp_message: `Hi ${lead.name}, thanks for reaching out! Our team has received your inquiry and will get back to you shortly.`\n  };\n}\n\n// Enforce 700 char hard cap\nif (parsed.personalized_whatsapp_message.length > 700) {\n  parsed.personalized_whatsapp_message = parsed.personalized_whatsapp_message.substring(0, 697) + '...';\n}\n\nreturn [{ json: { ...lead, ...parsed } }];"
      },
      "id": "ad3460c6-0996-4e7e-9352-1e7c8343e3db",
      "name": "Parse & Guard LLM Output",
